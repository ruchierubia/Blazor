@page "/employees"
@using BlazorEmployeeManagement.Models.Temp
@using BlazorEmployeeManagement.Services.Auth.Temp
@using Microsoft.AspNetCore.Authorization
@using BlazorEmployeeManagement.Components.Employee

@attribute [Authorize]
@rendermode InteractiveServer
@inject ITempEmployeeService TempEmployeeService

<PageTitle>Employees</PageTitle>

<h1>Employees</h1>
<a href="/employees/create" class="btn btn-primary mb-3">
    Create Employee
</a>

@if (_employees.Count == 0)
{
    <p>No employees found.</p>
}
else
{

    @foreach(var employee in _employees)
    {
        <EmployeeCard 
            Employee="employee" 
            OnDelete="DeleteEmployee">

        </EmployeeCard>
    }
}

@code {
    private List<TempEmployee> _employees = [];
    protected override void OnInitialized()
    {
        _employees = TempEmployeeService.GetEmployees();
    }

    private void DeleteEmployee(int id)
    {
        TempEmployeeService.DeleteEmployee(id);

        _employees = TempEmployeeService.GetEmployees();
    }

}
